<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="00000000000006-mpesa-payments" author="ndegwacodes">
    <dropNotNullConstraint tableName="order" columnName="stripe_session_id" columnDataType="varchar(256)"/>
    <addColumn tableName="order">
      <column name="payment_method" type="varchar(16)" defaultValue="STRIPE">
        <constraints nullable="false"/>
      </column>
      <column name="mpesa_checkout_request_id" type="varchar(128)">
        <constraints unique="true" uniqueConstraintName="ux_order_mpesa_checkout_request_id"/>
      </column>
      <column name="mpesa_receipt_number" type="varchar(32)"/>
      <column name="mpesa_phone_number" type="varchar(16)"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
